{
  // 健康营养课 —— 10 天 / 21 天顾客健康教育课程
  "name": "health-course",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "health-course-db", "database_id": "00000000-0000-4000-8000-000000000000" }
  ],
  "observability": { "enabled": true }
}
